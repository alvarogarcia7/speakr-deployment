# Copy to .env and edit (make init does the copy and fills the secrets for you).
# This file is also read by the Speakr app itself (env_file), so Speakr settings go here too.

# lite = ~725 MB image; "latest" adds semantic search (~4.4 GB)
SPEAKR_VERSION=lite
WHISPERX_VERSION=latest

# --- First admin login inside Speakr (created on first start) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ALLOW_REGISTRATION=false
SECRET_KEY=change-me
# true once you serve over HTTPS
SESSION_COOKIE_SECURE=false
TRUSTED_PROXY_HOPS=1

# --- Local transcription (WhisperX) ---
# Model loaded at start and used when an upload names none: tiny, base, small, medium,
# large-v3, large-v3-turbo, distil-large-v3.5. On CPU, small or medium is practical.
WHISPER_MODEL=small
# Models Speakr may pick per upload, comma separated (empty = any)
WHISPER_ALLOWED_MODELS=
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_BATCH_SIZE=2
# Speaker detection needs a free Hugging Face token and accepting the pyannote
# community-1 model terms. Without a token, keep ASR_DIARIZE=false.
HF_TOKEN=
ASR_DIARIZE=false
# GPU: uncomment, and change the WHISPERX_* values above (see docker-compose.gpu.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# --- Optional: summaries, titles and chat need a text model (local Ollama or an API) ---
# Leave empty to only transcribe and edit.
# TEXT_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# TEXT_MODEL_API_KEY=ollama
# TEXT_MODEL_NAME=llama3.1

# --- Caddy ---
# :80 = plain HTTP on HTTP_PORT (Tailscale or LAN). A domain name = automatic HTTPS;
# then set HTTP_PORT=80 and HTTPS_PORT=443 and point the domain's DNS at this server.
SITE_ADDRESS=:80
HTTP_PORT=8086
HTTPS_PORT=8446
PUBLIC_URL=http://localhost:8086
