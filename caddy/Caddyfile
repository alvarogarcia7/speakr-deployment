# Speakr behind Caddy: Authelia login (forward auth), status page while the app starts.
# HTTPS (HTTPS_PORT) serves Speakr behind the login. HTTP (HTTP_PORT) only redirects to HTTPS:
# Authelia issues its session cookie over HTTPS only, so Speakr cannot be behind the login on plain HTTP.
# The certificate for HTTPS comes from `make certs` (caddy/certs), copied by `make caddy-sync`.
{
	auto_https off
}

(speakr) {
	# While Speakr is not answering yet (502/503/504), show the status page from caddy/www
	handle_errors {
		@starting expression {http.error.status_code} in [502, 503, 504]
		handle @starting {
			root * /etc/caddy/www
			rewrite * /waiting.html
			file_server
		}
	}

	encode zstd gzip
	request_body {
		max_size 2GB
	}

	# Authelia's own login page and API: no login needed to reach them
	handle /authelia* {
		reverse_proxy authelia:9091
	}

	# Everything else: Authelia must confirm the session first, otherwise the browser is sent to its login page
	handle {
		forward_auth authelia:9091 {
			uri /authelia/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy {$UPSTREAM}
	}
}

http://{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}:{$PUBLIC_HTTPS_PORT}{uri} 302
}

https://{$SITE_ADDRESS} {
	tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
	import speakr
}
