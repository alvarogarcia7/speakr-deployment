# HTTPS with the local certificate from `make certs` (scripts/gen-certs.sh).
# Certificate and key are copied into /etc/caddy/certs by `make caddy-sync`.
# Plain HTTP on port 80 only redirects to the HTTPS port.
{
	auto_https off
}

http://{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}:{$PUBLIC_HTTPS_PORT}{uri} permanent
}

https://{$SITE_ADDRESS} {
	tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key

	# Written by `make password`: basic_auth { <user> <bcrypt hash> }
	import /etc/caddy/auth.caddy

	encode zstd gzip
	request_body {
		max_size 2GB
	}
	reverse_proxy {$UPSTREAM}
}
