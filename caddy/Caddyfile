# Speakr behind Caddy: basic auth (caddy/auth.caddy), status page while the app starts.
# HTTP (HTTP_PORT) and HTTPS (HTTPS_PORT) serve the same site; neither redirects to the other.
# The certificate for HTTPS comes from `make certs` (caddy/certs), copied by `make caddy-sync`.
{
	auto_https off
}

(speakr) {
	# Written by `make password`: basic_auth { <user> <bcrypt hash> }
	import /etc/caddy/auth.caddy

	# While Speakr is not answering yet (502/503/504), show the status page from caddy/www
	handle_errors {
		@starting expression {http.error.status_code} in [502, 503, 504]
		handle @starting {
			root * /etc/caddy/www
			rewrite * /waiting.html
			file_server
		}
	}

	encode zstd gzip
	request_body {
		max_size 2GB
	}
	reverse_proxy {$UPSTREAM}
}

http://{$SITE_ADDRESS} {
	import speakr
}

https://{$SITE_ADDRESS} {
	tls /etc/caddy/certs/server.crt /etc/caddy/certs/server.key
	import speakr
}
